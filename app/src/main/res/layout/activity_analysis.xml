<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PATTERN ANALYSIS"
            android:textColor="#FFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crime trends and risk insights"
            android:textColor="#9EA3AA" />

        <TextView
            style="@style/CSLabel"
            android:layout_marginTop="30dp"
            android:text="OVERVIEW" />

        <TextView
            android:id="@+id/tvTotal"
            style="@style/CSTextCard"
            android:layout_marginTop="12dp"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvHighRisk"
            style="@style/CSTextCard"
            android:layout_marginTop="12dp"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvTopCrime"
            style="@style/CSTextCard"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTopArea"
            style="@style/CSTextCard"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <TextView
            style="@style/CSLabel"
            android:layout_marginTop="30dp"
            android:text="RISK ANALYSIS" />

        <TextView
            android:id="@+id/tvAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1B2028"
            android:padding="20dp"
            android:textColor="#D0D4DA"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="CrimeShield • Anonymous Intelligence"
            android:textColor="#777D86"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>